{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test:system": "playwright test tests/system",
        "test:system:tb1": "playwright test tests/system/timebox1.spec.js",
        "test:system:tb2": "playwright test tests/system/timebox2.spec.js",
        "test:system:tb3": "playwright test tests/system/timebox3.spec.js",
        "test:system:tb4": "playwright test tests/system/timebox4.spec.js",
        "test:system:tb5": "playwright test tests/system/timebox5.spec.js",
        "test:system:tb1:report": "PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report/timebox-1 playwright test tests/system/timebox1.spec.js --reporter=list,html",
        "test:system:tb2:report": "PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report/timebox-2 playwright test tests/system/timebox2.spec.js --reporter=list,html",
        "test:system:tb3:report": "PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report/timebox-3 playwright test tests/system/timebox3.spec.js --reporter=list,html",
        "test:system:tb4:report": "PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report/timebox-4 playwright test tests/system/timebox4.spec.js --reporter=list,html",
        "test:system:tb5:report": "PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report/timebox-5 playwright test tests/system/timebox5.spec.js --reporter=list,html",
        "test:system:cross": "playwright test tests/system/cross-module.spec.js"
    },
    "dependencies": {
        "pinia": "^3.0.4",
        "primeicons": "^7.0.0",
        "primevue": "^3.53.1",
        "three": "^0.186.0",
        "vue": "^3.5.21",
        "vue-i18n": "^10.0.8",
        "vue-router": "^4.5.1",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "axios": "^1.11.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
