# Local development defaults.
VITE_API_BASE_URL=http://localhost:8000/api

# Comma-separated exact hostnames (no scheme or path) that Vite may serve.
# Set this to the hostname from the public frontend tunnel during ngrok development.
# Example: VITE_ALLOWED_HOSTS=frontend-example.ngrok-free.app
VITE_ALLOWED_HOSTS=
